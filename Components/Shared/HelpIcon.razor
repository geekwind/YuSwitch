@* 点击「?」弹出说明气泡；外部点击关闭。纯 Blazor @onclick，无 JS 依赖。
   复用 <Icon Name="help">；颜色/圆角/阴影全部走 --eg-* 变量，暗色自动适配。
   用法：<label>字段名 <HelpIcon Text="说明文字" /></label> *@

@* 注意：HelpIcon 通常嵌在 <label> 里，而 <button> 是 labelable element——label 会把点击
   合成转发给按钮。遮罩/气泡在 DOM 上是 label 后代，必须 preventDefault 阻断这次合成点击，
   否则「点遮罩关闭 → label 又合成点击按钮重新打开」，气泡永远关不掉。 *@
@if (_open)
{
    <div class="eg-help-backdrop" @onclick="Close" @onclick:preventDefault @onclick:stopPropagation aria-hidden="true"></div>
}
<span class="eg-help">
    <button type="button" class="eg-help-btn" @onclick="Toggle" @onclick:stopPropagation
            aria-label="查看说明" aria-expanded="@_open">
        <Icon Name="help" Size="14" />
    </button>
    @if (_open)
    {
        <span class="eg-help-popover" role="tooltip" @onclick:preventDefault @onclick:stopPropagation>@Text</span>
    }
</span>

@code {
    [Parameter] public string Text { get; set; } = "";
    private bool _open;
    private void Toggle() => _open = !_open;
    private void Close() => _open = false;
}
