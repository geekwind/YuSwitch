@inject RealtimeNotificationService Notifications
@implements IDisposable

<div class="eg-realtime-status">
    <Icon Name="broadcast" Size="14" />
    <span>@ConnectionText@(lastUpdate.HasValue ? $" · 最后更新 {lastUpdate.Value:HH:mm:ss}" : "")</span>
</div>

@code {
    private string? _connectionId;
    private bool _isConnected = false;
    private DateTime? lastUpdate;

    private string ConnectionText => _isConnected ? "已连接" : "已断开";

    protected override void OnInitialized()
    {
        // In-process pub/sub key: a per-instance GUID (NOT the HTTP connection
        // id — IHttpContextAccessor.HttpContext is null inside interactive
        // circuits, which used to leave every subscriber with a null key and
        // silently disabled all realtime notifications).
        _connectionId = Guid.NewGuid().ToString("N");
        _isConnected = true;

        if (!string.IsNullOrEmpty(_connectionId))
        {
            // Subscribe to notifications to update the timestamp
            Notifications.Subscribe(_connectionId, "new-log", _ => OnNotification());
        }
    }

    private void OnNotification()
    {
        InvokeAsync(() =>
        {
            lastUpdate = DateTime.Now;
            StateHasChanged();
        });
    }

    /// <summary>
    /// Call this to manually update the last refresh time
    /// </summary>
    public void RefreshTimestamp()
    {
        lastUpdate = DateTime.Now;
        StateHasChanged();
    }

    public void Dispose()
    {
        // No timer here: the page-head badge is fed by events alone. (It used to
        // run a 5s loop that updated a subscriber count which was never shown.)
        if (!string.IsNullOrEmpty(_connectionId))
        {
            Notifications.Unsubscribe(_connectionId, "new-log");
        }
    }
}
