    // Parses a numeric field; falls back to the default on any invalid input,
    // mirroring AppSettingsService.GetD/GetI clamping. Invariant culture for doubles.
    private static double ParseD(string raw, double fallback, double min, double max) =>
        double.TryParse(raw, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var v) && v >= min && v <= max
            ? v : fallback;

    private static int ParseI(string raw, int fallback, int min, int max) =>
        int.TryParse(raw, out var v) && v >= min && v <= max ? v : fallback;

    private async Task SaveTuning()
    {
        saving = true;
        try
        {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var resp = await Http.PutAsJsonAsync("/admin/settings", new Dictionary<string, string>
            {
                [AppSettingsService.KeyLbEwmaAlpha] = ParseD(lbEwmaAlpha, 0.3, 0.01, 1.0).ToString(inv),
                [AppSettingsService.KeyBreakerFailureThreshold] = ParseI(breakerFailureThreshold, 3, 1, 100).ToString(),
                [AppSettingsService.KeyBreakerCooldownBaseS] = ParseI(breakerCooldownBaseS, 10, 1, 3600).ToString(),
                [AppSettingsService.KeyBreaker429PenaltyMs] = ParseD(breaker429PenaltyMs, 400.0, 0, 1_000_000).ToString(inv),
                [AppSettingsService.KeyBreaker429WindowS] = ParseI(breaker429WindowS, 30, 1, 3600).ToString(),
                [AppSettingsService.KeyInFlightPenaltyMs] = ParseD(inFlightPenaltyMs, 500.0, 0, 1_000_000).ToString(inv),
                [AppSettingsService.KeyEwmaDecayS] = ParseD(ewmaDecayS, 4.0, 0.1, 3600).ToString(inv),
                [AppSettingsService.KeyLbStickyFactor] = ParseD(lbStickyFactor, 2.0, 1.0, 100.0).ToString(inv),
                [AppSettingsService.KeyRequestTimeoutDefaultS] = ParseI(requestTimeoutDefaultS, 120, 5, 3600).ToString(),
                [AppSettingsService.KeyRateLimitEnabled] = rateLimitEnabled ? "true" : "false",
                [AppSettingsService.KeyUsageLogRetentionDays] = ParseI(usageLogRetentionDays, 30, 1, 365).ToString(),
            });
            if (resp.IsSuccessStatusCode)
            {
                lbEwmaAlpha = Settings.LbEwmaAlpha.ToString(inv);
                breakerFailureThreshold = Settings.BreakerFailureThreshold.ToString();
                breakerCooldownBaseS = Settings.BreakerCooldownBaseS.ToString();
                breaker429PenaltyMs = Settings.Breaker429PenaltyMs.ToString(inv);
                breaker429WindowS = Settings.Breaker429WindowS.ToString();
                inFlightPenaltyMs = Settings.InFlightPenaltyMs.ToString(inv);
                ewmaDecayS = Settings.EwmaDecayS.ToString(inv);
                lbStickyFactor = Settings.LbStickyFactor.ToString(inv);
                requestTimeoutDefaultS = Settings.RequestTimeoutDefaultS.ToString();
                usageLogRetentionDays = Settings.UsageLogRetentionDays.ToString();
                rateLimitEnabled = Settings.RateLimitEnabled;
                Toasts.Ok("负载均衡 / 熔断设置已保存");
            }
            else
            {
                Toasts.Error(await resp.Content.ReadAsStringAsync());
            }
        }
        finally { saving = false; }
    }

