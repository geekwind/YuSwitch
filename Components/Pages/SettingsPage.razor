    private async Task ExportConfig()
    {
        exporting = true;
        try
        {
            var json = await Http.GetStringAsync("/admin/export");
            var fileName = $"yuswitch-config-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            // Trigger a browser download via a data URL (config JSON is small).
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
            await JS.InvokeVoidAsync("eval",
                $"(() => {{ const a = document.createElement('a'); a.href = 'data:application/json;base64,{b64}'; a.download = '{fileName}'; a.click(); }})()");
            Toasts.Ok("配置已导出");
        }
        catch (Exception ex)
        {
            Toasts.Error("导出失败：" + ex.Message);
        }
        finally { exporting = false; }
    }

    private async Task ImportConfig(InputFileChangeEventArgs e)
    {
        importMsg = null;
        var file = e.File;
        if (file is null) return;
        if (file.Size > 5 * 1024 * 1024)
        {
            Toasts.Error("文件过大（>5MB），不是有效的配置导出文件。");
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new StreamContent(stream);
            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
            var resp = await Http.PostAsync("/admin/import", content);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ImportResult>();
                importMsg = $"导入完成：服务 +{result?.services?.added ?? 0}（跳过 {result?.services?.skipped ?? 0}）· " +
                            $"API Key +{result?.apiKeys?.added ?? 0}（跳过 {result?.apiKeys?.skipped ?? 0}）";
                Toasts.Ok("配置已导入");
            }
            else
            {
                Toasts.Error("导入失败：" + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            Toasts.Error("导入失败：" + ex.Message);
        }
    }

    private class ImportResult
    {
        public ImportCount? services { get; set; }
        public ImportCount? apiKeys { get; set; }
    }
    private class ImportCount { public int added { get; set; } public int skipped { get; set; } }

