@inherits LayoutComponentBase
@inject AppSettingsService Settings
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.JSInterop
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <span class="eg-crumb">@Crumb</span>
            <span class="flex-fill"></span>
            <span class="eg-status-pill" title="网关监听地址">
                <span class="dot"></span>
                网关运行中 · <span class="eg-mono">@Settings.ListenHost:@Settings.ListenPort</span>
            </span>
            <RealtimeStatus />
            <button class="eg-theme-toggle" title="@(isDark ? "切换到浅色" : "切换到深色")" @onclick="ToggleTheme">
                <Icon Name="@(isDark ? "sun" : "moon")" Size="14" />
            </button>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // Dark is the product default; OnAfterRender syncs the real value anyway.
    private bool isDark = true;

    protected override void OnInitialized()
    {
        Settings.Changed += OnSettingsChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Settings.Changed -= OnSettingsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    // 面包屑：分组 / 页面（与侧栏分组一致）
    private string Crumb
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return path switch
            {
                "" => "总览 / 仪表盘",
                "services" => "配置 / 服务管理",
                "apikeys" => "配置 / API Key",
                "playground" => "观测 / 接口测试",
                "usage" => "观测 / 用量统计",
                "logs" => "观测 / 调用日志",
                "dispatch-trace" => "观测 / 路由追踪",
                "realtime" => "观测 / 实时订阅",
                "settings" => "系统 / 设置",
                _ => path,
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync the toggle icon with the theme eg.js already applied pre-boot.
            // Defensive: a stale cached eg.js without egGetTheme must degrade to
            // the default icon, not kill the whole circuit.
            try
            {
                var theme = await JS.InvokeAsync<string>("egGetTheme");
                var dark = theme == "dark";
                if (dark != isDark)
                {
                    isDark = dark;
                    StateHasChanged();
                }
            }
            catch (JSException) { /* old cached script — toggle still works */ }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        try
        {
            await JS.InvokeVoidAsync("egSetTheme", isDark ? "dark" : "light");
        }
        catch (JSException)
        {
            // Stale eg.js: set the attribute directly; persistence kicks in
            // after the next hard refresh loads the current script.
            await JS.InvokeVoidAsync("eval",
                $"document.documentElement.setAttribute('data-theme','{(isDark ? "dark" : "light")}')");
        }
    }
}
