@inherits LayoutComponentBase
@inject AppSettingsService Settings
@inject IJSRuntime JS
@using Microsoft.JSInterop
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button class="eg-theme-toggle" title="@(isDark ? "切换到亮色" : "切换到暗色")" @onclick="ToggleTheme">
                @if (isDark)
                {
                    @* sun *@
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                }
                else
                {
                    @* moon *@
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                }
            </button>
            <span class="eg-topbar-badge"><span class="dot"></span> @Settings.AppName · @Settings.Subtitle</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isDark;

    protected override void OnInitialized() => Settings.Changed += OnSettingsChanged;
    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Settings.Changed -= OnSettingsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync the toggle icon with the theme eg.js already applied pre-boot.
            // Defensive: a stale cached eg.js without egGetTheme must degrade to
            // the default icon, not kill the whole circuit.
            try
            {
                var theme = await JS.InvokeAsync<string>("egGetTheme");
                var dark = theme == "dark";
                if (dark != isDark)
                {
                    isDark = dark;
                    StateHasChanged();
                }
            }
            catch (JSException) { /* old cached script — toggle still works */ }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        try
        {
            await JS.InvokeVoidAsync("egSetTheme", isDark ? "dark" : "light");
        }
        catch (JSException)
        {
            // Stale eg.js: set the attribute directly; persistence kicks in
            // after the next hard refresh loads the current script.
            await JS.InvokeVoidAsync("eval",
                $"document.documentElement.setAttribute('data-theme','{(isDark ? "dark" : "light")}')");
        }
    }
}
