@inject ToastService Toasts
@implements IDisposable

@if (items.Count > 0)
{
    <div class="eg-toast-wrap">
        @foreach (var t in items)
        {
            <div class="eg-toast @t.Kind" @onclick="() => Toasts.Dismiss(t.Id)">
                <span class="eg-toast-icon">
                    @if (t.Kind == "ok") { <Icon Name="check-circle" /> }
                    else if (t.Kind == "err") { <Icon Name="x-circle" /> }
                    else { <Icon Name="info" /> }
                </span>
                <span>@t.Message</span>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyCollection<ToastService.Toast> items = Array.Empty<ToastService.Toast>();

    protected override void OnInitialized()
    {
        Refresh();
        Toasts.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh() => items = Toasts.Active.ToList();

    public void Dispose() => Toasts.Changed -= OnChanged;
}
